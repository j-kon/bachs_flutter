# Merchant-owned Bachs sandbox credentials (NEVER set in Flutter).
BACHS_API_KEY=sk_sandbox_REPLACE_WITH_YOUR_KEY
# Optional until you need to test signed webhook deliveries.
BACHS_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET
# Public HTTPS merchant pages; not localhost, even in Bachs sandbox.
BACHS_SUCCESS_URL=https://your-own-domain.example/thanks
BACHS_CANCEL_URL=https://your-own-domain.example/cancel
# Path relative to the server's working directory.
BACHS_CATALOG_FILE=config/catalog.json
